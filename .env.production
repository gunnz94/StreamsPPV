# Production Environment Configuration
# Copy this to .env on your production server

# Application settings
NODE_ENV=production
PORT=7000
HOST=0.0.0.0

# Performance tuning
UV_THREADPOOL_SIZE=128
NODE_OPTIONS=--max-old-space-size=4096 --optimize-for-size

# Cache settings
CACHE_DURATION=300000
MAX_CACHE_SIZE=1073741824
CLEANUP_INTERVAL=600000

# Puppeteer optimization
MAX_CONCURRENT_SCRAPES=4
PUPPETEER_TIMEOUT=60000
PUPPETEER_HEADLESS=true

# Network settings
REQUEST_TIMEOUT=30000
MAX_CONNECTIONS=1000
KEEP_ALIVE_TIMEOUT=65000

# Security
ENABLE_RATE_LIMITING=true
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090
LOG_LEVEL=info

# Cloudflare settings
CLOUDFLARE_BYPASS_ENABLED=true
CLOUDFLARE_CACHE_TTL=300000

# API settings
API_BASE_URL=https://ppv.gstream.stream
STREAMS_API_URL=https://ppv.gstream.stream/streams.json

# Health check
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=5000

# Memory management
GC_INTERVAL=300000
MEMORY_ALERT_THRESHOLD=2147483648

# Production URLs
BASE_URL=https://addon3.gstream.stream
MANIFEST_URL=https://addon3.gstream.stream/manifest.json
